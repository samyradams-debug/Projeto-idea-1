<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>


<VBox alignment="CENTER"
      spacing="14"
      prefWidth="420"
      prefHeight="500"
      style="-fx-background-color: #f4f6f8;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.CadastroUsuarioController">


    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>


    <Label text="Criar Conta"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #193b63;"/>


    <Label text="Hospital Samyra &amp; Heloísa"
           style="-fx-font-size: 14px;
                  -fx-text-fill: #193b63;"/>


    <TextField fx:id="nomeField"
               promptText="Nome completo"
               maxWidth="Infinity"/>


    <TextField fx:id="usuarioField"
               promptText="Crie um nome de usuário"
               maxWidth="Infinity"/>


    <PasswordField fx:id="senhaField"
                   promptText="Crie uma senha"
                   maxWidth="Infinity"/>


    <PasswordField fx:id="confirmarSenhaField"
                   promptText="Confirme sua senha"
                   maxWidth="Infinity"/>


    <Button text="CADASTRAR USUÁRIO"
            onAction="#cadastrar"
            maxWidth="Infinity"
            style="-fx-background-color: #198754;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-padding: 12;"/>


    <Button text="Voltar para o login"
            onAction="#voltar"
            maxWidth="Infinity"
            style="-fx-background-color: #193b63;
                   -fx-text-fill: white;
                   -fx-padding: 10;"/>


</VBox>
