<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>


<VBox alignment="CENTER"
      spacing="18"
      prefWidth="420"
      prefHeight="320"
      style="-fx-background-color: #f4f6f8;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.Tela3Controller">


   <padding>
      <Insets top="25" right="30" bottom="25" left="30"/>
   </padding>


   <Label text="HOSPITAL SAMYRA &amp; HELOÍSA"
          style="-fx-font-size: 17px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #193b63;"/>


   <Label text="PACIENTE CADASTRADO!"
          style="-fx-font-size: 21px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #198754;"/>


   <VBox spacing="12"
         maxWidth="Infinity"
         style="-fx-background-color: white;
                 -fx-background-radius: 10px;
                 -fx-padding: 20px;
                 -fx-border-color: #d9e0e7;
                 -fx-border-radius: 10px;">


      <Label fx:id="nomeLabel"
             text="Nome:"
             style="-fx-font-size: 15px;
                      -fx-text-fill: #193b63;"/>


      <Label fx:id="idLabel"
             text="ID:"
             style="-fx-font-size: 15px;
                      -fx-text-fill: #193b63;"/>


   </VBox>


   <Button text="Voltar ao cadastro"
           onAction="#voltarAoCadastro"
           maxWidth="Infinity"
           style="-fx-background-color: #193b63;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-padding: 12px;
                   -fx-background-radius: 6px;
                   -fx-cursor: hand;"/>


</VBox>