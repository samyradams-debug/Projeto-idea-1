<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER"
      spacing="15.0"
      prefWidth="430.0"
      prefHeight="390.0"
      style="-fx-background-color: #f4f6f8;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.Tela4Controller">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>
    <VBox alignment="CENTER"
          spacing="16.0"
          maxWidth="370.0"
          style="-fx-background-color: white;
                 -fx-background-radius: 15;
                 -fx-border-color: #e1e7ed;
                 -fx-border-radius: 15;
                 -fx-padding: 25;">
        <Label text="Cadastro de Médicos"
               style="-fx-font-size: 22px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #193b63;"/>
        <Label text="Preencha os dados do profissional"
               style="-fx-font-size: 12px;
                      -fx-text-fill: #6c7a89;"/>
        <TextField fx:id="idField"
                   promptText="Digite o ID do médico"
                   maxWidth="Infinity"
                   style="-fx-background-radius: 7;
                          -fx-border-color: #d5dde5;
                          -fx-border-radius: 7;
                          -fx-padding: 10;"/>
        <TextField fx:id="nomeField"
                   promptText="Digite o nome do médico"
                   maxWidth="Infinity"
                   style="-fx-background-radius: 7;
                          -fx-border-color: #d5dde5;
                          -fx-border-radius: 7;
                          -fx-padding: 10;"/>
        <TextField fx:id="especialidadeField"
                   promptText="Digite a especialidade"
                   maxWidth="Infinity"
                   style="-fx-background-radius: 7;
                          -fx-border-color: #d5dde5;
                          -fx-border-radius: 7;
                          -fx-padding: 10;"/>
        <Button text="Cadastrar Médico"
                onAction="#cadastrarMedico"
                maxWidth="Infinity"
                style="-fx-background-color: #198754;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 11;
                       -fx-cursor: hand;"/>
        <Button text="Voltar"
                onAction="#voltar"
                maxWidth="Infinity"
                style="-fx-background-color: #193b63;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 11;
                       -fx-cursor: hand;"/>
    </VBox>
</VBox>