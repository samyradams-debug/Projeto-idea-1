<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="15.0"
      prefWidth="400.0"
      prefHeight="350.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.Tela4Controller">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Cadastro de Médicos"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TextField fx:id="idField"
               promptText="Digite o ID do médico"/>

    <TextField fx:id="nomeField"
               promptText="Digite o nome do médico"/>

    <TextField fx:id="especialidadeField"
               promptText="Digite a especialidade"/>

    <Button text="Cadastrar Médico"
            onAction="#cadastrarMedico"
            maxWidth="Infinity"/>

    <Button text="Voltar"
            onAction="#voltar"
            maxWidth="Infinity"/>

</VBox>