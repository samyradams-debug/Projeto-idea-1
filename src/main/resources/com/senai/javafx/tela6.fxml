<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER"
      spacing="12.0"
      prefWidth="700.0"
      prefHeight="650.0"
      style="-fx-background-color: #f4f6f8;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.Tela6Controller">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>
    <VBox alignment="CENTER"
          spacing="13.0"
          maxWidth="650.0"
          style="-fx-background-color: white;
                 -fx-background-radius: 15;
                 -fx-border-color: #e1e7ed;
                 -fx-border-radius: 15;
                 -fx-padding: 22;">
        <Label text="Consultas e Histórico"
               style="-fx-font-size: 24px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #193b63;"/>
        <Label text="Consulte os atendimentos registrados"
               style="-fx-font-size: 12px;
                      -fx-text-fill: #6c7a89;"/>
        <ComboBox fx:id="pacienteCombo"
                  promptText="Selecione um paciente"
                  maxWidth="Infinity"
                  style="-fx-background-radius: 7;"/>
        <Button text="Consultar histórico do paciente"
                onAction="#consultarHistoricoPaciente"
                maxWidth="Infinity"
                style="-fx-background-color: #193b63;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 10;
                       -fx-cursor: hand;"/>
        <ComboBox fx:id="medicoCombo"
                  promptText="Selecione um médico"
                  maxWidth="Infinity"
                  style="-fx-background-radius: 7;"/>
        <Button text="Consultar consultas do médico"
                onAction="#consultarPorMedico"
                maxWidth="Infinity"
                style="-fx-background-color: #193b63;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 10;
                       -fx-cursor: hand;"/>
        <Button text="Listar todas as consultas"
                onAction="#listarTodas"
                maxWidth="Infinity"
                style="-fx-background-color: #198754;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 10;
                       -fx-cursor: hand;"/>
        <ListView fx:id="consultasList"
                  VBox.vgrow="ALWAYS"
                  prefHeight="250.0"
                  style="-fx-background-radius: 8;
                         -fx-border-color: #d5dde5;
                         -fx-border-radius: 8;"/>
        <Button text="Cancelar consulta selecionada"
                onAction="#cancelarConsulta"
                maxWidth="Infinity"
                style="-fx-background-color: #c0392b;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 10;
                       -fx-cursor: hand;"/>
        <Button text="Voltar ao menu"
                onAction="#voltar"
                maxWidth="Infinity"
                style="-fx-background-color: #193b63;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 10;
                       -fx-cursor: hand;"/>
    </VBox>
</VBox>