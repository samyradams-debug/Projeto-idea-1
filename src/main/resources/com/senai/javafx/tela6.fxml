<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="12"
      prefWidth="650"
      prefHeight="550"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.Tela6Controller">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Consultas e Histórico"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <ComboBox fx:id="pacienteCombo"
              promptText="Selecione um paciente"
              maxWidth="Infinity"/>

    <Button text="Consultar histórico do paciente"
            onAction="#consultarHistoricoPaciente"
            maxWidth="Infinity"/>

    <ComboBox fx:id="medicoCombo"
              promptText="Selecione um médico"
              maxWidth="Infinity"/>

    <Button text="Consultar consultas do médico"
            onAction="#consultarPorMedico"
            maxWidth="Infinity"/>

    <Button text="Listar todas as consultas"
            onAction="#listarTodas"
            maxWidth="Infinity"/>

    <ListView fx:id="consultasList"
              VBox.vgrow="ALWAYS"
              prefHeight="250"/>

    <Button text="Cancelar consulta selecionada"
            onAction="#cancelarConsulta"
            maxWidth="Infinity"/>

    <Button text="Voltar ao menu"
            onAction="#voltar"
            maxWidth="Infinity"/>

</VBox>
