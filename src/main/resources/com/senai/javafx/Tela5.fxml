<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="12.0"
      prefWidth="420.0"
      prefHeight="450.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.Tela5Controller">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <Label text="Registro de Consultas"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <ComboBox fx:id="pacienteCombo"
              promptText="Selecione o paciente"
              maxWidth="Infinity"/>

    <ComboBox fx:id="medicoCombo"
              promptText="Selecione o médico"
              maxWidth="Infinity"/>

    <DatePicker fx:id="dataPicker"
                promptText="Data da consulta"
                maxWidth="Infinity"/>

    <TextField fx:id="horaField"
               promptText="Horário (ex.: 14:30)"/>

    <Button text="Registrar Consulta"
            onAction="#registrarConsulta"
            maxWidth="Infinity"/>

    <Button text="Voltar"
            onAction="#voltar"
            maxWidth="Infinity"/>

</VBox>
