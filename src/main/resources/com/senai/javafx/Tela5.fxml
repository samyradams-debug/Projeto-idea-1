<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER"
      spacing="15.0"
      prefWidth="450.0"
      prefHeight="510.0"
      style="-fx-background-color: #f4f6f8;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.Tela5Controller">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>
    <VBox alignment="CENTER"
          spacing="16.0"
          maxWidth="390.0"
          style="-fx-background-color: white;
                 -fx-background-radius: 15;
                 -fx-border-color: #e1e7ed;
                 -fx-border-radius: 15;
                 -fx-padding: 25;">
        <Label text="Registro de Consultas"
               style="-fx-font-size: 22px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #193b63;"/>
        <Label text="Informe os dados do atendimento"
               style="-fx-font-size: 12px;
                      -fx-text-fill: #6c7a89;"/>
        <ComboBox fx:id="pacienteCombo"
                  promptText="Selecione o paciente"
                  maxWidth="Infinity"
                  style="-fx-background-radius: 7;"/>
        <ComboBox fx:id="medicoCombo"
                  promptText="Selecione o médico"
                  maxWidth="Infinity"
                  style="-fx-background-radius: 7;"/>
        <DatePicker fx:id="dataPicker"
                    promptText="Data da consulta"
                    maxWidth="Infinity"
                    style="-fx-background-radius: 7;"/>
        <TextField fx:id="horaField"
                   promptText="Horário (ex.: 14:30)"
                   maxWidth="Infinity"
                   style="-fx-background-radius: 7;
                          -fx-border-color: #d5dde5;
                          -fx-border-radius: 7;
                          -fx-padding: 10;"/>
        <Button text="Registrar Consulta"
                onAction="#registrarConsulta"
                maxWidth="Infinity"
                style="-fx-background-color: #198754;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 11;
                       -fx-cursor: hand;"/>
        <Button text="Voltar"
                onAction="#voltar"
                maxWidth="Infinity"
                style="-fx-background-color: #193b63;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 11;
                       -fx-cursor: hand;"/>
    </VBox>
</VBox>