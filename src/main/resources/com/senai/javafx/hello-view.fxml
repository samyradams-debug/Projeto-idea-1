<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="15.0"
      prefWidth="350.0"
      prefHeight="280.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.HelloController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Cadastro de Paciente"/>

    <TextField fx:id="nomeField"
               promptText="Digite o nome do paciente"/>

    <TextField fx:id="idField"
               promptText="Digite o ID do paciente"/>

    <Button text="Cadastrar"
            onAction="#cadastrarPaciente"/>
    
    <Button text="Cadastrar Médico"
            onAction="#abrirCadastroMedico"/>
</VBox>
