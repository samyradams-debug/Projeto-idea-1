<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>


<VBox alignment="CENTER"
      spacing="16"
      prefWidth="420"
      prefHeight="420"
      style="-fx-background-color: #f4f6f8;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.HelloController">


    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>


    <Label text="HOSPITAL"
           style="-fx-font-size: 14px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #198754;"/>


    <Label text="Samyra &amp; Heloísa"
           style="-fx-font-size: 25px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #193b63;"/>


    <Label text="Cadastro de Paciente"
           style="-fx-font-size: 19px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #193b63;"/>


    <TextField fx:id="nomeField"
               promptText="Digite o nome do paciente"
               maxWidth="Infinity"
               style="-fx-background-color: white;
                      -fx-border-color: #ced4da;
                      -fx-border-radius: 6px;
                      -fx-background-radius: 6px;
                      -fx-padding: 12px;
                      -fx-font-size: 14px;"/>


    <TextField fx:id="idField"
               promptText="Digite o ID do paciente"
               maxWidth="Infinity"
               style="-fx-background-color: white;
                      -fx-border-color: #ced4da;
                      -fx-border-radius: 6px;
                      -fx-background-radius: 6px;
                      -fx-padding: 12px;
                      -fx-font-size: 14px;"/>


    <Button text="Cadastrar Paciente"
            onAction="#cadastrarPaciente"
            maxWidth="Infinity"
            style="-fx-background-color: #198754;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-background-radius: 6px;
                   -fx-padding: 12px;
                   -fx-cursor: hand;"/>


    <Button text="Cadastrar Médico"
            onAction="#abrirCadastroMedico"
            maxWidth="Infinity"
            style="-fx-background-color: #193b63;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-background-radius: 6px;
                   -fx-padding: 12px;
                   -fx-cursor: hand;"/>


</VBox>