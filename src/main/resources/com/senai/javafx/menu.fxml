<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>


<VBox alignment="CENTER"
      spacing="16"
      prefWidth="500"
      prefHeight="460"
      style="-fx-background-color: #f4f6f8;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.MenuController">


    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>


    <Label text="HOSPITAL"
           style="-fx-font-size: 14px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #198754;"/>


    <Label text="SAMYRA &amp; HELOÍSA"
           style="-fx-font-size: 25px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #193b63;"/>


    <Label text="Sistema de gerenciamento de atendimentos"
           style="-fx-font-size: 14px;
                  -fx-text-fill: #555555;"/>


    <Label text="MENU PRINCIPAL"
           style="-fx-font-size: 18px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #193b63;"/>


    <Button text="Cadastrar paciente"
            onAction="#abrirPacientes"
            maxWidth="Infinity"
            style="-fx-background-color: #198754;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-padding: 12px;
                   -fx-background-radius: 6px;
                   -fx-cursor: hand;"/>


    <Button text="Cadastrar médico"
            onAction="#abrirMedicos"
            maxWidth="Infinity"
            style="-fx-background-color: #193b63;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-padding: 12px;
                   -fx-background-radius: 6px;
                   -fx-cursor: hand;"/>


    <Button text="Registrar consulta"
            onAction="#abrirConsultas"
            maxWidth="Infinity"
            style="-fx-background-color: #198754;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-padding: 12px;
                   -fx-background-radius: 6px;
                   -fx-cursor: hand;"/>


    <Button text="Consultar e gerenciar consultas"
            onAction="#abrirGerenciamento"
            maxWidth="Infinity"
            style="-fx-background-color: #193b63;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-padding: 12px;
                   -fx-background-radius: 6px;
                   -fx-cursor: hand;"/>


</VBox>