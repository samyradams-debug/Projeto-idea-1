<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="15"
      prefWidth="500"
      prefHeight="420"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.MenuController">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="CLÍNICA MÉDICA"
           style="-fx-font-size: 25px; -fx-font-weight: bold;"/>

    <Label text="Sistema de gerenciamento de atendimentos"/>

    <Button text="Cadastrar paciente"
            onAction="#abrirPacientes"
            maxWidth="Infinity"/>

    <Button text="Cadastrar médico"
            onAction="#abrirMedicos"
            maxWidth="Infinity"/>

    <Button text="Registrar consulta"
            onAction="#abrirConsultas"
            maxWidth="Infinity"/>

    <Button text="Consultar e gerenciar consultas"
            onAction="#abrirGerenciamento"
            maxWidth="Infinity"/>

</VBox>
